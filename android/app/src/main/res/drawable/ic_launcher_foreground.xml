<?xml version="1.0" encoding="utf-8"?>
<!--
  Alpha Gravity mark: the "A" runner from the menu logo, orbited by its gravity ring.
  Drawn in the 108x108 adaptive-icon viewport, kept inside the 66x66 safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="54" android:translateY="54" android:scaleX="0.6" android:scaleY="0.6">
        <!-- the A -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M0,-44 L34,38 H17 L0,-5 L-17,38 H-34 Z" />
        <group android:rotation="-18">
            <!-- gravity ring -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#7C4DFF"
                android:strokeWidth="5"
                android:pathData="M-47,0 a47,15 0 1,0 94,0 a47,15 0 1,0 -94,0" />
            <!-- orbiting body -->
            <path
                android:fillColor="#FF3B6B"
                android:pathData="M43,-5 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
        </group>
    </group>
</vector>
